# LOOTBOX keys. Copy this file to .env and paste each key in yourself. Never commit .env.
# Grouped by when each system needs it. Anything left blank keeps that system in demo mode.

# --- Backbone ---
# Supabase: Project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never give it a NEXT_PUBLIC_ name: that would ship it to every visitor.
SUPABASE_SERVICE_ROLE_KEY=
# Connect -> Session pooler -> URI, with your database password in place of [YOUR-PASSWORD].
# Used only to set up the database tables (npm run db:migrate).
SUPABASE_DB_URL=
# Any long random string. The scheduler sends it, so only the scheduler can run the drop engine.
CRON_SECRET=

# --- Solana ---
# devnet (free test network) until launch, then mainnet-beta
SOLANA_CLUSTER=devnet
# Helius: dashboard -> API keys. Used for every Solana read and write when set.
HELIUS_API_KEY=

# --- Money in ---
# The token holders are snapshotted for (on devnet: tLOOT, from npm run devnet:setup)
LOOT_MINT=
# Secret key (base58) of the treasury, where the pool collects. On mainnet this is the wallet
# that launches $LOOT, so pump.fun's creator fees land in it.
TREASURY_WALLET_SECRET=
# Public address the prize money moves to the moment a pool fills
PRIZE_WALLET=
# Secret key (base58) of the ops wallet: it pays fees and signs proof posts and randomness
# requests. Keep only a little SOL in it.
OPS_WALLET_SECRET=
# Extra wallets left out of every snapshot, comma separated (bonding curve, AMM pool, team).
# The treasury, prize and ops wallets are always left out.
EXCLUDED_WALLETS=
# When the first drop opens (ISO time, e.g. 2026-11-18T17:00:00Z). Devnet drops open right away.
LAUNCH_AT=

# --- Live fee coins ---
# Any long random string. Helius sends it with every trade it delivers to /api/fees, so only
# Helius can add fee events. Set it here and in Vercel, then run npm run helius:webhook.
FEES_WEBHOOK_SECRET=
# Where Helius delivers trades (defaults to https://getlootbox.fun/api/fees)
FEES_WEBHOOK_URL=

# --- Alerts ---
# A Discord or Telegram webhook the engine posts to when something needs you
ALERT_WEBHOOK_URL=

# --- Claim ---
# Shopify collects the winner's shipping address at a $0 checkout.
# The store's .myshopify.com address, e.g. lootbox-claims.myshopify.com
SHOPIFY_STORE_DOMAIN=
# Admin API access, with the write_draft_orders scope. Either an Admin API access token
# (shpat_...), or the app's client ID and secret (apps made in Shopify's Dev Dashboard).
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Signs the "Order creation" webhook sent to https://<site>/api/shopify/orders. Made under
# Settings -> Notifications -> Webhooks, it's the key shown there ("signed with ..."); made by the
# app itself, it's the app's client secret.
SHOPIFY_WEBHOOK_SECRET=
# Optional: Admin API version (defaults to 2026-01)
SHOPIFY_API_VERSION=

# --- Buy + deliver ---
# Zinc (app.zinc.com -> API keys). Buys the prize. A sandbox key (zn_test_...) places free
# pretend orders; devnet drops refuse to run with any other key.
ZINC_API_KEY=
ZINC_BASE_URL=https://api.zinc.com
# "bearer" for zn_... keys (Zinc's current API); "basic" only for the old v1 API
ZINC_AUTH=bearer
# Zinc needs a phone number for the carrier. Used only when the winner's checkout gave none
# (turn on "Require phone number" in Shopify's checkout settings so it always does).
ZINC_FALLBACK_PHONE=
# id of a placed order, for the go/no-go tests. With a sandbox key, npm run gate:zinc makes one.
ZINC_ORDER_ID=

# Reclaim (dev.reclaimprotocol.org -> new zkFetch app)
RECLAIM_APP_ID=
RECLAIM_APP_SECRET=

# AfterShip: Settings -> API keys
AFTERSHIP_API_KEY=

# Your own test shipping details, used ONLY to check nothing leaks into a proof
TEST_PII_NAME=
TEST_PII_EMAIL=
TEST_PII_PHONE=
TEST_PII_LINE1=
TEST_PII_CITY=
TEST_PII_ZIP=
