# LOOTBOX keys. Copy this file to .env and paste each key in yourself. Never commit .env.
# Grouped by when each system needs it. Anything left blank keeps that system in demo mode.

# --- Backbone ---
# Supabase: Project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never give it a NEXT_PUBLIC_ name: that would ship it to every visitor.
SUPABASE_SERVICE_ROLE_KEY=
# Connect -> Session pooler -> URI, with your database password in place of [YOUR-PASSWORD].
# Used only to set up the database tables (npm run db:migrate).
SUPABASE_DB_URL=
# Any long random string. The scheduler sends it, so only the scheduler can run the drop engine.
CRON_SECRET=

# --- Solana ---
# devnet (free test network) until launch, then mainnet-beta
SOLANA_CLUSTER=devnet
# Helius: dashboard -> API keys. Used for every Solana read and write when set.
HELIUS_API_KEY=

# --- Money in ---
# Public addresses (safe to share): the token, and the wallets the site shows and watches
LOOT_MINT=
CREATOR_WALLET=
PRIZE_WALLET=
# Secret key (base58) of the ops wallet: it signs fee claims, swaps and proof posts.
# Keep only a little SOL in it.
OPS_WALLET_SECRET=

# --- Alerts ---
# A Discord or Telegram webhook the engine posts to when something needs you
ALERT_WEBHOOK_URL=

# --- Claim ---
# Shopify: Settings -> Apps -> Develop apps -> your app
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# --- Buy + deliver ---
# Zinc (app.zinc.com)
ZINC_API_KEY=
ZINC_BASE_URL=https://api.zinc.io/v1
# "basic" (key as username) or "bearer" - check Zinc's docs for your key type
ZINC_AUTH=basic
# request_id of a real test order you placed (for the go/no-go test)
ZINC_ORDER_ID=

# Reclaim (dev.reclaimprotocol.org -> new zkFetch app)
RECLAIM_APP_ID=
RECLAIM_APP_SECRET=

# AfterShip: Settings -> API keys
AFTERSHIP_API_KEY=

# Your own test shipping details, used ONLY to check nothing leaks into a proof
TEST_PII_NAME=
TEST_PII_EMAIL=
TEST_PII_PHONE=
TEST_PII_LINE1=
TEST_PII_CITY=
TEST_PII_ZIP=
