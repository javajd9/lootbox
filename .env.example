# LOOTBOX keys. Copy this file to .env and paste each key in yourself. Never commit .env.
# Grouped by system. Anything left blank turns that part off.

# --- Backbone ---
# Supabase: Project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never give it a NEXT_PUBLIC_ name: that would ship it to every visitor.
SUPABASE_SERVICE_ROLE_KEY=
# Connect -> Session pooler -> URI, with your database password in place of [YOUR-PASSWORD].
# Used only to set up the database tables (npm run db:migrate).
SUPABASE_DB_URL=
# Any long random string. The scheduler sends it, so only the scheduler can run the drop engine.
CRON_SECRET=

# --- Solana (mainnet) ---
# Helius: dashboard -> API keys. Used for every Solana read and write when set.
HELIUS_API_KEY=

# --- Money in ---
# npm run mainnet:wallets makes the treasury, prize and ops wallets and fills in the four lines below
# (keeping each key in .keys/mainnet-*.json too). Back those files up: the treasury key holds the pool.
# $LOOT's mint address, once it's created on pump.fun. The token holders are snapshotted for.
LOOT_MINT=
# Secret key (base58) of the treasury, where the pool collects. It's the wallet that creates $LOOT on
# pump.fun (with no fee sharing), so the creator fees land in it. All its SOL counts as the pool.
TREASURY_WALLET_SECRET=
# Public address the prize money moves to, as USDC, the moment a pool fills
PRIZE_WALLET=
# Secret key (base58) of that same prize wallet. Each order is paid in USDC straight from it, so
# there's no Zinc balance to top up (lib/orders/x402.ts). It only ever holds a drawn drop's prize money.
PRIZE_WALLET_SECRET=
# Secret key (base58) of the ops wallet: it pays fees and signs proof posts and randomness
# requests. Keep only a little SOL in it (0.1 or more).
OPS_WALLET_SECRET=
# Extra wallets left out of every snapshot, comma separated (team and dev wallets).
# The treasury, prize and ops wallets, the bonding curve and the pool are always left out.
EXCLUDED_WALLETS=
# When the first drop opens (ISO time with a zone, e.g. 2026-11-18T17:00:00Z). Until it's set, it stays shut.
LAUNCH_AT=

# --- Official links ---
# The X account, shown in the footer; /docs/addresses tells people the addresses are pinned there.
# Left out until it's set. (Buy $LOOT goes to pump.fun on its own once LOOT_MINT is set.)
X_URL=https://x.com/getlootbox

# --- Live fee coins ---
# Any long random string. Helius sends it with every trade it delivers to /api/fees, so only
# Helius can add fee events. Set it here and in Vercel, then run npm run helius:webhook.
FEES_WEBHOOK_SECRET=
# Where Helius delivers trades (defaults to https://www.getlootbox.fun/api/fees)
FEES_WEBHOOK_URL=

# --- Alerts (optional) ---
# The engine raises an alert when something needs you: a hold, slow randomness or delivery, or a
# step failing for 10 minutes. Left blank, alerts go to Vercel's logs only (Logs -> search "[alert]").
# Set it to a Discord channel webhook to get them as messages (sent as Discord's {"content": ...}).
ALERT_WEBHOOK_URL=

# --- Claim ---
# Shopify collects the winner's shipping address at a $0 checkout.
# The store's .myshopify.com address, e.g. lootbox-claims.myshopify.com
SHOPIFY_STORE_DOMAIN=
# Admin API access, with the write_draft_orders scope. Either an Admin API access token
# (shpat_...), or the app's client ID and secret (apps made in Shopify's Dev Dashboard).
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Signs the "Order creation" webhook sent to https://<site>/api/shopify/orders. Made under
# Settings -> Notifications -> Webhooks, it's the key shown there ("signed with ..."); made by the
# app itself, it's the app's client secret.
SHOPIFY_WEBHOOK_SECRET=
# Optional: Admin API version (defaults to 2026-01)
SHOPIFY_API_VERSION=

# --- Buy + deliver ---
# Zinc buys the prize. With PRIZE_WALLET_SECRET set (above) it needs no account or key here: leave
# ZINC_API_KEY blank. Without it, orders are charged to a prepaid Zinc balance with this key
# (app.zinc.com -> API keys). The engine refuses a zn_test_ key: a sandbox order never ships.
ZINC_API_KEY=
ZINC_BASE_URL=https://api.zinc.com
# "bearer" for zn_... keys (Zinc's current API); "basic" only for the old v1 API
ZINC_AUTH=bearer
# Zinc needs a phone number for the carrier. Used only when the winner's checkout gave none
# (turn on "Require phone number" in Shopify's checkout settings so it always does).
ZINC_FALLBACK_PHONE=
# ID of a placed order, read by npm run gate:zinc and gate:zkfetch. With a zn_test_ key,
# gate:zinc places one.
ZINC_ORDER_ID=

# Reclaim (dev.reclaimprotocol.org -> new zkFetch app)
RECLAIM_APP_ID=
RECLAIM_APP_SECRET=

# The shipping details on that order: gate:zkfetch checks none of it leaks into a proof, and
# gate:x402 --pay ships its real test order there
TEST_PII_NAME=
TEST_PII_EMAIL=
TEST_PII_PHONE=
TEST_PII_LINE1=
TEST_PII_CITY=
TEST_PII_STATE=
TEST_PII_ZIP=
